# Example Terraform variables file
# Copy this to terraform.tfvars and customize as needed

# General Configuration
aws_region   = "us-east-1"
project_name = "serverless-secure-webapp"
environment  = "dev"

# VPC Configuration
vpc_cidr = "10.0.0.0/16"

# Public Subnets (for NAT Gateway, Load Balancers, etc.)
public_subnet_cidrs = [
  "10.0.1.0/24",
  "10.0.2.0/24"
]

# Private Subnets (for RDS, Lambda, etc.)
private_subnet_cidrs = [
  "10.0.10.0/24",
  "10.0.20.0/24"
]

# Database Configuration
db_engine         = "mysql"           # or "postgres"
db_engine_version = "8.0"             # MySQL 8.0 or PostgreSQL version
db_instance_class = "db.t3.micro"     # Instance class
db_name           = "webapp"
db_username       = "admin"
db_port           = 3306              # 3306 for MySQL, 5432 for PostgreSQL

# Database Storage
db_allocated_storage     = 20
db_max_allocated_storage = 100

# Database Backup
db_backup_retention_period = 7
db_backup_window          = "03:00-04:00"
db_maintenance_window     = "sun:04:00-sun:05:00"

# Database Protection
db_skip_final_snapshot = true   # Set to false for production
db_deletion_protection = false  # Set to true for production

# Tags
tags = {
  Project     = "serverless-secure-webapp"
  Environment = "dev"
  ManagedBy   = "terraform"
  Owner       = "your-team"
  CostCenter  = "engineering"
}
